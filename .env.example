# TravelScout configuration. Copy to `.env` in the repository root (next to this file).
# The backend loads it explicitly; the frontend never receives any of these values.

# --- Required for the AI agents ---------------------------------------------------------
# Without a key the app still runs: demo search, manual import and rule-based planning work,
# but natural-language interpretation and the LLM agents are disabled.
OPENAI_API_KEY=sk-your-key-here
# Optional model override (must support tool calling + structured output).
# OPENAI_MODEL=gpt-4o-mini

# --- Live travel data (opt-in, unofficial, for private low-volume use) ---------------------
# Wizz Air has no public API. This reads the public route map + lowest-fare calendar used by
# wizzair.com. No flight numbers, arrival times or bag prices (protected; not bypassed).
WIZZ_LIVE_ENABLED=false
# Booking.com's Demand API needs an affiliate contract. This reads booking.com with a normal
# Chromium browser via Playwright (run `python -m playwright install chromium` once).
# BOOKING_WINDOW: offscreen (default, nothing pops up) | visible (lets you solve a CAPTCHA) | headless
# (Booking.com blocks headless browsers). A CAPTCHA is never bypassed automatically.
BOOKING_SCRAPER_ENABLED=false
BOOKING_WINDOW=offscreen

# --- Other data sources (free, documented, no key) -----------------------------------------
OSM_ENABLED=true
FX_LIVE_ENABLED=true
# Optional contact string added to the OpenStreetMap User-Agent (recommended by their policy).
# CONTACT_EMAIL=you@example.com

# --- Workflow budget ------------------------------------------------------------------------
# MAX_SHORTLIST=5                   # trips that get an accommodation search
# MAX_PROPERTIES_PER_DESTINATION=5  # Booking.com property pages opened per trip
# MAX_JOB_SECONDS=420               # hard time budget per search
# CACHE_TTL_MINUTES=180

# --- Optional LangSmith tracing (disabled by default) ----------------------------------------
# When enabled, prompts, tool calls/results and model outputs are sent to LangSmith.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2-your-key-here
# LANGSMITH_PROJECT=travelscout
